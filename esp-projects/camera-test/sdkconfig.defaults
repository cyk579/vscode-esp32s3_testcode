#
# SPIRAM
#
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=150000
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

#
# USB
#
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=3000
CONFIG_USB_HOST_HW_BUFFER_BIAS_IN=y

#
# WIFI
#
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=8

#
# LWIP
#
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=15000

# Use the fixed native USB OTG pins on ESP32-S3 for the camera host.
# Keep Wi-Fi/TCP streaming off in the vehicle build. The TFT preview is
# enabled for this debug build; disable it in menuconfig for maximum speed.
# CONFIG_EXAMPLE_ENABLE_STREAMING is not set
CONFIG_EXAMPLE_ENABLE_TFT_PREVIEW=y
# Enable the vehicle task by default; it keeps TB6612 in standby until a line
# is confirmed. Disable this in menuconfig for camera-only diagnostics.
CONFIG_EXAMPLE_ENABLE_CAMERA_LINE_FOLLOW=y
CONFIG_EXAMPLE_ENABLE_ENCODERS=y
CONFIG_EXAMPLE_ENCODER_SAMPLE_PERIOD_MS=10
CONFIG_EXAMPLE_ENCODER_COUNTS_PER_REV=1
# CONFIG_EXAMPLE_ENCODER_A_INVERT is not set
# CONFIG_EXAMPLE_ENCODER_B_INVERT is not set
# CONFIG_EXAMPLE_ENCODER_D_INVERT is not set

# Decode UVC MJPEG frames to the ST7735's RGB565 input.  Use the external
# decoder so common UVC frames without an embedded Huffman table also work.
# CONFIG_JD_USE_ROM is not set
CONFIG_JD_FORMAT_RGB565=y
CONFIG_JD_USE_SCALE=y
CONFIG_JD_TBLCLIP=y
CONFIG_JD_FASTDECODE_32BIT=y
CONFIG_JD_DEFAULT_HUFFMAN=y
