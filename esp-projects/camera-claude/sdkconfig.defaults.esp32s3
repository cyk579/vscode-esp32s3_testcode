#
# SPIRAM
#
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y

# ESP32-S3-WROOM-2-N32R16V fitted on this board.
CONFIG_ESPTOOLPY_OCT_FLASH=y
CONFIG_ESPTOOLPY_FLASHMODE_OPI=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y

# 与本仓库 camera-test 的 N32R16V 配置一致；80MHz为本工程选定频率。
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASH_SAMPLE_MODE_DTR=y
CONFIG_SPI_FLASH_OCTAL_32BIT_ADDR_ENABLE=y

# 保留现有欠压检测设置，不用更改阈值来掩盖供电问题。
# 实际阈值以当前 ESP-IDF 的 menuconfig 为准。
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_7=y

CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# USB副控制台仅在USB PHY被摄像头接管前可用；运行日志走UART0。
# CONFIG_ESP_CONSOLE_SECONDARY_NONE is not set
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG_ENABLED=y

#
# SYSTEM
#
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
