#
# PSRAM（摄像头帧缓冲和 JPEG 解码缓冲需要）
#
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=150000

# 本车 ESP32-S3-WROOM-2-N32R16V：32MB Octal Flash，80MHz DTR。
CONFIG_ESPTOOLPY_OCT_FLASH=y
CONFIG_ESPTOOLPY_FLASHMODE_OPI=y
CONFIG_ESPTOOLPY_FLASH_SAMPLE_MODE_DTR=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_SPI_FLASH_OCTAL_32BIT_ADDR_ENABLE=y

# 摄像头使用 GPIO19/20 的 USB PHY，日志使用 UART0 TX=43/RX=44。
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

#
# CPU
#
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

#
# USB Host（UVC 摄像头）
#
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=3000
CONFIG_USB_HOST_HW_BUFFER_BIAS_IN=y
